generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Roles: "ADMIN" | "VENDEDOR" (ver src/lib/constants.ts)
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("VENDEDOR")
  active       Boolean  @default(true)
  leads        Lead[]
  sales        Sale[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id           String         @id @default(cuid())
  slug         String         @unique
  brand        String
  model        String
  version      String?
  year         Int
  km           Int            @default(0)
  // Precio en unidades enteras de la moneda (sin centavos)
  price        Int
  currency     String         @default("USD") // "ARS" | "USD"
  condition    String         @default("USADO") // "NUEVO" | "USADO"
  fuel         String         @default("NAFTA")
  transmission String         @default("MANUAL")
  bodyType     String         @default("SEDAN")
  color        String?
  doors        Int?
  description  String?
  status       String         @default("DISPONIBLE") // "DISPONIBLE" | "RESERVADO" | "VENDIDO"
  published    Boolean        @default(true)
  featured     Boolean        @default(false)
  images       VehicleImage[]
  leads        Lead[]
  sales        Sale[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, published])
  @@index([brand])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // Ruta relativa dentro del almacenamiento (ej: "vehiculos/<id>/<archivo>.jpg")
  path      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([vehicleId, position])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  dni       String?
  address   String?
  notes     String?
  leads     Lead[]
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([email])
}

// Consulta que llega desde la web o que carga un vendedor.
model Lead {
  id            String    @id @default(cuid())
  type          String    @default("CONSULTA") // "CONSULTA" | "TEST_DRIVE"
  source        String    @default("WEB") // "WEB" | "WHATSAPP" | "TELEFONO" | "PRESENCIAL"
  status        String    @default("NUEVO") // "NUEVO" | "CONTACTADO" | "CERRADO" | "DESCARTADO"
  name          String
  phone         String
  email         String?
  message       String?
  preferredDate String? // Día/horario preferido para el test drive (texto libre)
  notes         String? // Notas internas del vendedor
  vehicleId     String?
  vehicle       Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedToId  String?
  assignedTo    User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([assignedToId])
}

model Sale {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerId      String?
  seller        User?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  date          DateTime @default(now())
  price         Int
  currency      String   @default("USD")
  paymentMethod String   @default("CONTADO") // "CONTADO" | "FINANCIADO" | "MIXTO"
  // Usado recibido como parte de pago (opcional)
  tradeIn       String?
  tradeInValue  Int?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([date])
}
