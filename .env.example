# Copiá este archivo como .env y completá los valores.

# --- Base de datos (Supabase) ---
# En Supabase: botón "Connect" del proyecto → "ORMs" → Prisma. Reemplazá [YOUR-PASSWORD] por la
# contraseña de la base.
# Para la web: pooler en modo "transaction" (puerto 6543).
DATABASE_URL="postgresql://postgres.xxxxxxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
# Para crear y actualizar las tablas: pooler en modo "session" (puerto 5432).
DIRECT_URL="postgresql://postgres.xxxxxxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Fotos (Supabase Storage) ---
# En Supabase: Project Settings → API. La "service_role" (o "secret") es secreta: nunca la
# pongas en una variable que empiece con NEXT_PUBLIC_.
# Si las dejás vacías, las fotos se guardan en la carpeta uploads/ (sirve para probar en tu compu).
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# El bucket se crea solo (público) con la primera foto.
SUPABASE_BUCKET="fotos"

# --- Sesiones del panel ---
# Generá una clave con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Usuario administrador inicial (lo crea `npm run db:seed`). En Vercel no hace falta:
# la primera vez que entres a /admin te pide crearlo.
SEED_ADMIN_EMAIL="admin@automotoreslaureano.com.ar"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"
# Poné "true" para que `npm run db:seed` cree 8 autos de ejemplo (solo para probar).
SEED_SAMPLE_VEHICLES="false"

# --- Datos de contacto que se muestran en la web ---
NEXT_PUBLIC_WHATSAPP_NUMBER="5491100000000"
NEXT_PUBLIC_CONTACT_PHONE="(011) 0000-0000"
NEXT_PUBLIC_CONTACT_EMAIL="ventas@automotoreslaureano.com.ar"
NEXT_PUBLIC_CONTACT_ADDRESS="Av. Siempre Viva 1234, Buenos Aires"

# Dirección pública del sitio (para Google y las vistas previas al compartir).
# En Vercel se toma sola del dominio de producción; completala si usás dominio propio.
NEXT_PUBLIC_SITE_URL=""
