# Copiá este archivo como .env y completá los valores.


# Base de datos PostgreSQL. En tu compu podés usar una base gratis de Neon (neon.tech)
# o un Postgres local. En Vercel la carga sola la integración de Neon.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/laureano"

# Clave para firmar las sesiones del panel. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Usuario administrador inicial (lo crea `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@automotoreslaureano.com.ar"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"

# Datos de contacto que se muestran en la web
NEXT_PUBLIC_WHATSAPP_NUMBER="5491100000000"
NEXT_PUBLIC_CONTACT_PHONE="(011) 0000-0000"
NEXT_PUBLIC_CONTACT_EMAIL="ventas@automotoreslaureano.com.ar"
NEXT_PUBLIC_CONTACT_ADDRESS="Av. Siempre Viva 1234, Buenos Aires"

# Dirección pública del sitio (para Google y las vistas previas al compartir).
# En Vercel se toma sola del dominio de producción; completala si usás dominio propio.
NEXT_PUBLIC_SITE_URL=""

# Fotos en Vercel Blob. En Vercel la carga sola el Blob store; en tu compu dejala vacía
# y las fotos se guardan en la carpeta uploads/.
BLOB_READ_WRITE_TOKEN=""

# Poné "true" para que `npm run db:seed` cree 8 autos de ejemplo (solo para probar).
SEED_SAMPLE_VEHICLES="false"
